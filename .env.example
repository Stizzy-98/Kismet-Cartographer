# Optional. Everything here can also be given as ./install flags (flags win over this file).
# Copy to .env (chmod 600) and pass it with --env-file, or export the variables. NEVER commit real values.

# Use http:// here if your stack does not use HTTPS (no CA needed then)
ELASTIC_URL=https://elasticsearch.example.com:9200
KIBANA_URL=https://kibana.example.com:5601

# The API key: the "encoded" value from ./install --print-api-key-request. Better than putting the key itself in a file
# that lives next to the code: keep it in its own file (chmod 600) and point at that file instead.
ELASTIC_API_KEY_FILE=
# ELASTIC_API_KEY=

# PEM CA certificate(s), only if your stack uses a private CA. Kibana's defaults to the Elasticsearch one.
# ELASTIC_CA_CERT=/path/to/es-ca.crt
# KIBANA_CA_CERT=/path/to/kibana-ca.crt

# Kibana space to install into (default: the default space)
# KIBANA_SPACE=

# Only when you reach a service through another name than its certificate lists (kubectl port-forward):
# ELASTIC_TLS_SERVER_NAME=<es-name>-es-http.<namespace>.svc
# KIBANA_TLS_SERVER_NAME=<kb-name>-kb-http.<namespace>.svc

# Throw-away tests only: skip certificate verification
# ELASTIC_VERIFY_CERTS=false
